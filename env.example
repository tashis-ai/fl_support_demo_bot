# Скопируйте в .env и заполните значения:
#   cp env.example .env

# ProxyAPI (обязательно) — https://proxyapi.ru/
PROXYAPI_API_KEY=your_proxyapi_key_here
PROXYAPI_MODEL=gpt-4o-mini
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Telegram-бот (обязательно для APP_MODE=3)
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Прокси только для Telegram (опционально)
# Пусто = напрямую (рекомендуется на VPS)
# Локально в РФ при необходимости:
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=

# Режим запуска: 1 = консоль, 2 = демо, 3 = Telegram
APP_MODE=3

# Опционально
# EMBEDDING_MODEL=text-embedding-3-small
